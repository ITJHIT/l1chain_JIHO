# JSON-RPC endpoint of your l1 node.
#
# The browser calls the same-origin /api/rpc proxy (app/api/rpc/route.ts),
# which runs on the Next.js server and forwards to this URL. Prefer RPC_URL
# (server-side only, not exposed to the browser).
#
# Local dev:      http://127.0.0.1:8545
# ngrok tunnel:   https://<subdomain>.ngrok.io
# cloud VM:       http://<vm-public-ip>:8545  (or a domain with TLS)
RPC_URL=http://127.0.0.1:8545

# Optional public fallback (exposed to the browser bundle). Only needed if you
# want the browser to know the node URL directly; the proxy above is preferred.
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
